# Copie para .env.local e preencha com os dados do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Só no servidor (Vercel): usada pela tarefa diária que mantém o Supabase ativo.
SUPABASE_SECRET_KEY=sb_secret_xxx
# A Vercel envia este segredo no cabeçalho Authorization das chamadas de cron.
CRON_SECRET=troque-por-um-texto-aleatorio
